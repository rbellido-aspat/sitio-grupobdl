{
  "trailingSlash": "always",
  "routes": [
    { "route": "/inicio/", "redirect": "/", "statusCode": 301 },
    { "route": "/acerca-de/", "redirect": "/empresa-grupobdl/", "statusCode": 301 },
    { "route": "/contacto/", "redirect": "/contacto-grupobdl/", "statusCode": 301 },
    { "route": "/homeprueba/", "redirect": "/", "statusCode": 301 },
    { "route": "/feed/", "redirect": "/blog/", "statusCode": 301 },
    { "route": "/comments/feed/", "redirect": "/blog/", "statusCode": 301 },
    { "route": "/category/*", "redirect": "/blog/", "statusCode": 301 },
    { "route": "/author/*", "redirect": "/blog/", "statusCode": 301 },
    { "route": "/page/*", "redirect": "/blog/", "statusCode": 301 },
    { "route": "/wp-admin/*", "redirect": "/", "statusCode": 301 },
    { "route": "/wp-login.php", "redirect": "/", "statusCode": 301 },
    { "route": "/wp-content/uploads/*", "headers": { "Cache-Control": "public, max-age=2592000" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=86400" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
